{% extends 'base.html.twig' %}

{% block title %}Hello Pokemon Editor!{% endblock %}

{% block body %}
    <style>
        .example-wrapper {
            margin: 1em auto;
            max-width: 800px;
            width: 95%;
            font: 18px/1.5 sans-serif;
        }

        .example-wrapper code {
            background: #F5F5F5;
            padding: 2px 6px;
        }
    </style>

    <div class="example-wrapper">
        <h1>Hello {{ controller_name }}! ✅</h1>

        You can:
        <ul>
            <li><a href="{{ path('app_admin_pokemon') }}">Wiev and Edit Pokemon</a></li>
            <li>Your controller at <code><a
                            href="{{ '/var/www/html/src/Controller/AdminController.php'|file_link(0) }}">src/Controller/AdminController.php</a></code>
            </li>
            <li>Your template at <code><a href="{{ '/var/www/html/templates/admin/index.html.twig'|file_link(0) }}">templates/admin/index.html.twig</a></code>
            </li>
        </ul>
    </div>
{% endblock %}
